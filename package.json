{
  "name": "agniwar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "server"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:server": "npm --workspace server run dev",
    "build": "node apps/web/scripts/site.mjs && npm run typecheck && npm --workspace apps/web run build && npm --workspace server run build",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test:lan": "node tests/lan-e2e.mjs",
    "test:storage": "node tests/storage-e2e.mjs",
    "bench": "node tests/bench.mjs",
    "test:lan-large": "node tests/lan-large.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "playwright": "^1.65.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
